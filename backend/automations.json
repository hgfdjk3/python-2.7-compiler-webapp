    "name": "New Automation",
    "nodes": [
      {
        "id": "1",
        "type": "automation",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "title": "Root Directory Discovery",
          "description": "Iterate through a predefined list of possible root paths (e.g., '/', '/home', '/var', 'C:\\', etc.) and use `list_directory` to test each. The first path that returns a successful directory listing is selected as the root for the scan.",
          "tools": [
            "list_directory"
          ]
        }
      },
      {
        "id": "2",
        "type": "automation",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "title": "Recursive File Enumeration",
          "description": "Starting from the discovered root, repeatedly call `list_directory` to walk the directory tree depth\u2011first, collecting the full path of every regular file. Sub\u2011directories are queued for further listing until the entire tree is traversed.",
          "tools": [
            "list_directory"
          ]
        }
      },
      {
        "id": "3",
        "type": "automation",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "title": "Longest Path Calculation",
          "description": "Process the accumulated list of file paths, compute the character length of each full pathname, and keep the entry with the maximum length.",
          "tools": []
        }
      },
      {
        "id": "4",
        "type": "automation",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "title": "Result Notification",
          "description": "Emit the longest file path and its length to the user (e.g., via console output, email, or messaging service). If no files were found, report that outcome.",
          "tools": []
        }
      }
    ],
